# Proveedor del LLM: gemini | ollama
PROVEEDOR=gemini

# Solo se usa cuando PROVEEDOR=gemini
GOOGLE_API_KEY=tu_api_key_aqui

# Modelos
MODELO_LLM=gemini-3.5-flash-lite
MODELO_EMBEDDINGS=gemini-embedding-001
DIM_EMBEDDINGS=768

# Limites del agente
MAX_ITERACIONES=6
MAX_REPLANIFICACIONES=1

# 1 simula la caida del servicio de Inventario (para la demo)
INVENTARIO_CAIDO=0
